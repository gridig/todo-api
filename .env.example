# Application
# Local template — the quickstart (cp .env.example .env && pnpm run dev) must
# boot out of the box, so this defaults to development. Deployed images bake
# NODE_ENV=production into the Dockerfile; production additionally REQUIRES
# METRICS_TOKEN and real (non-placeholder) ENCRYPTION_* keys or startup aborts.
NODE_ENV=development
PORT=3001

# Database
# DATABASE_URL is the runtime app connection — uses the restricted db_app role
# (no UPDATE/DELETE on audit_entries). DATABASE_MIGRATE_URL is used only by
# `prisma migrate deploy` and connects as the schema owner (db_admin) so it
# can run DDL and GRANT/REVOKE. Roles and dev passwords are created by
# prisma/sql/bootstrap_roles.sql via the docker-compose initdb hook.
DATABASE_URL="postgresql://db_app:db_app_dev@localhost:5432/todo_api"
DATABASE_MIGRATE_URL="postgresql://db_admin:db_admin_dev@localhost:5432/todo_api"

# JWT (minimum 32 characters — server fails to start otherwise)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32
# JWT_ISSUER=todo-api          # iss claim. Same value on sign and verify.
# JWT_AUDIENCE=todo-api-clients # aud claim. Same value on sign and verify.
# ACCESS_TOKEN_EXPIRY=15m       # Access-token lifetime (jsonwebtoken expiresIn). Keep short.
# REFRESH_TOKEN_EXPIRY_DAYS=30  # Refresh-token lifetime in days (rotated on every /auth/refresh).
# VERIFICATION_TOKEN_EXPIRY_HOURS=24  # Email-verification link lifetime (single use).
# JWT_SECRET_PREVIOUS=          # Set to the OLD secret only during a JWT_SECRET rotation
#                               # (accepted on verify so in-flight tokens survive). Min 32
#                               # chars when set; clear it after ACCESS_TOKEN_EXPIRY elapses.
#                               # See docs/operations.md → JWT secret rotation.

# Field-level encryption (users.email at rest). See docs/configuration.md → "Encryption at rest".
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The placeholders below are 32 zero bytes — the server REFUSES to boot in
# production on them, so replace both with real per-environment key material.
# ENCRYPTION_KEYRING: comma-separated <keyId>:<base64-32-byte-key>. New writes use
# ENCRYPTION_ACTIVE_KEY_ID; keep retired keys here until re-encryption drains them.
ENCRYPTION_KEYRING=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ENCRYPTION_ACTIVE_KEY_ID=k1
# ENCRYPTION_BLIND_INDEX_KEY: base64 32-byte HMAC key for the email lookup/uniqueness
# column. Rotating it requires re-hashing every row — see docs/operations.md.
ENCRYPTION_BLIND_INDEX_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Outbound mail / email verification. See docs/configuration.md → "Email Verification
# & Outbound Mail". Login is gated on a verified address, so these are not optional
# in production: leaving RESEND_API_KEY or MAIL_FROM unset selects the dev log
# transport (which prints the link instead of sending it), and every new account
# would be permanently unusable. Production REFUSES to boot without all three.
#
# Dev/CI: leave the first two unset — the log transport is what you want locally.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Todo API <noreply@example.com>
#
# APP_BASE_URL is the frontend origin the verification link points at
# (<APP_BASE_URL>/verify-email?token=…). It DEFAULTS to http://localhost:3000, and
# production rejects any localhost value — so it must be set explicitly there even
# though the variable technically already has a value.
APP_BASE_URL=http://localhost:3000
#
# Escape hatch for a production-MODE stack that serves no real users (the
# docker-compose stack, e2e runs): boot without a mail vendor and read the
# verification link out of the log. Relaxes the RESEND/MAIL_FROM and
# localhost-APP_BASE_URL checks together, and logs a loud WARNING. Never set it
# on a user-serving deploy — every account would be stranded unverified.
# ALLOW_LOG_MAIL_TRANSPORT_PRODUCTION_CONFIRM=false

# Number of proxy hops Express trusts when deriving req.ip (rate-limit keys, audit
# sourceIp). Railway / a single LB = 1; add one per extra fronting proxy (CDN in
# front of the LB = 2). Too high and clients can spoof req.ip via X-Forwarded-For,
# defeating every per-IP limit — set it to the real hop count for your deployment.
TRUST_PROXY=1

# HTTP Request Body Limit
BODY_LIMIT=16kb

# CORS Configuration (CORS_ORIGIN is REQUIRED — app fails to start without it)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=false
CORS_METHODS=GET,HEAD,POST,PATCH,DELETE
CORS_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=86400
CORS_ALLOW_NO_ORIGIN=true  # Set false in browser-only deployments

# Logging
LOG_LEVEL=debug # Options: trace, debug, info, warn, error, fatal

# Benchmarking
DISABLE_RATE_LIMIT=false  # Set to true when running load tests. To enable in production, also set DISABLE_RATE_LIMIT_PRODUCTION_CONFIRM=true — otherwise startup aborts.
# DISABLE_RATE_LIMIT_PRODUCTION_CONFIRM=false  # Required alongside DISABLE_RATE_LIMIT=true in production. Use only on a dedicated benchmark process, never on an instance serving real traffic.
# ENABLE_ECHO_ROUTES=     # Mount /echo benchmark routes. Defaults to true outside production, false in production. To enable in production, also set ENABLE_ECHO_ROUTES_PRODUCTION_CONFIRM=true — otherwise startup aborts. Use only on a dedicated benchmark process, never on an instance serving real traffic.
# ENABLE_ECHO_ROUTES_PRODUCTION_CONFIRM=false  # Required alongside ENABLE_ECHO_ROUTES=true in production. The two-flag pattern makes the intent explicit and reviewable in env-var diffs.

# Shutdown Configuration
SHUTDOWN_DELAY_MS=5000     # ms to wait after SIGTERM (K8s endpoint propagation)
SHUTDOWN_TIMEOUT_MS=10000  # Force-exit if graceful drain exceeds this

# Database Pool Configuration
# DB_POOL_MAX × replica_count must stay below Postgres max_connections (default 100)
DB_POOL_MAX=10             # Max connections per instance
DB_POOL_MIN=2              # Min idle connections to keep warm
DB_CONNECTION_TIMEOUT_MS=5000   # ms to wait for a free connection
DB_IDLE_TIMEOUT_MS=10000        # ms before idle connection is released
DB_QUERY_TIMEOUT_MS=5000        # ms a single query may run before the connection is killed
DB_PROBE_TIMEOUT_MS=1000        # ms /health/ready waits for SELECT 1 on its dedicated probe
                                # connection. Tighter than DB_QUERY_TIMEOUT_MS so probe latency
                                # stays under k8s readiness timeoutSeconds under saturation.

# Startup connection retry (decorrelated jitter, capped at 30s)
# DB_CONNECT_MAX_RETRIES=5         # Retries after the initial $connect; 0 disables retry
# DB_CONNECT_INITIAL_DELAY_MS=1000 # Base delay for the first retry

# Redis (optional — enables distributed rate limiting for multi-instance deployments)
# REDIS_URL=redis://localhost:6379

# Cluster (optional — spawns multiple worker processes to utilize all CPU cores)
# CLUSTER_WORKERS=0  # 0 = auto-detect CPU count, 1 = disabled (default), N = exact count
# When clustering: set DB_POOL_MAX = floor(postgres_max_connections / workers / replicas) - 1

# Metrics
# Set (not commented out) because docker-compose interpolates it with ${METRICS_TOKEN:?…}:
# a commented entry here makes every `docker compose` command fail on a fresh clone.
# Replace before any deploy — this value is public.
METRICS_TOKEN=dev-metrics-token-change-me-min-32-chars  # Bearer token for GET /metrics and /health/ready/detailed. REQUIRED in production (>=32 chars; startup aborts otherwise). Header-only, no ?token= fallback.
# DISABLE_DB_METRICS=false  # Set true when running benchmarks to avoid per-query timer overhead

# HTTP Server Timeouts
# SERVER_HEADERS_TIMEOUT_MS=60000    # ms for full headers (should exceed LB idle timeout)
# SERVER_REQUEST_TIMEOUT_MS=30000    # ms for full request body
# SERVER_KEEP_ALIVE_TIMEOUT_MS=65000 # ms idle keep-alive (must exceed LB idle timeout)

# For test environment configuration, see docs/testing.md
