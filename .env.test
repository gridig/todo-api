# Test environment configuration — safe to commit, no real secrets.
# Loaded by `__tests__/setup.ts` via `dotenv.config({ path: '.env.test' })`.

# Database (matches the ephemeral Postgres service in .github/workflows/ci.yml).
# DATABASE_URL is the runtime app role (db_app, audit-table immutability holds).
# DATABASE_MIGRATE_URL is the schema-owner role used by `prisma migrate deploy`
# and the privileged TRUNCATE pool in __tests__/helpers/testSetup.ts.
DATABASE_URL=postgresql://db_app:db_app_dev@localhost:5432/todo_api
DATABASE_MIGRATE_URL=postgresql://db_admin:db_admin_dev@localhost:5432/todo_api

# Application
NODE_ENV=test
PORT=3002

# JWT — setup.ts overrides this with a longer placeholder before tests run;
# left here for direct-jest invocations that bypass setup.ts.
# (Must be >=32 chars to pass the config/env.ts validator.)
JWT_SECRET=test-jwt-secret-key-for-testing-only-min-32-chars

# CORS — required for `__tests__/integration/cors.test.ts` to assert on
# the specific echoed origin (any value other than `*` triggers the
# per-origin validator in middleware/cors.ts).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=false
CORS_METHODS=GET,HEAD,POST,PATCH,DELETE
CORS_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=86400

# Logging
LOG_LEVEL=debug

# Metrics token — exercises the auth path for /metrics and /health/ready/detailed
# in integration tests. Any value >= 32 chars works; not a real secret.
METRICS_TOKEN=test-metrics-token-please-replace-32-chars
