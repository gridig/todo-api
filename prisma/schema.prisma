generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id         String   @id @default(uuid()) @db.Uuid
  text       String   @db.VarChar(500)
  done       Boolean  @default(false)
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("todos")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  // AES-256-GCM ciphertext envelope (lib/crypto/fieldCrypto.ts). NOT unique —
  // randomized ciphertext can't back a unique constraint; emailHash does.
  email      String
  // Keyed HMAC-SHA256 blind index over the canonical email. Carries account
  // uniqueness and every login lookup (findByEmail).
  emailHash  String   @unique @map("email_hash")
  // Optional user-chosen display name. Lower-sensitivity than email and needs
  // no equality lookup, so it is stored as plaintext (unlike the encrypted
  // email column). Nullable — existing rows and registration don't set it.
  name       String?  @db.VarChar(100)
  // Authorization role. Plain String (not a PG enum) so db_app needs no TYPE
  // USAGE grant; a CHECK (role IN ('user','admin')) constraint enforces the
  // domain at the DB layer — added in raw migration SQL, so `prisma migrate
  // diff` (schema-to-schema) never sees it. App-side domain: UserRole union.
  role       String   @default("user")
  password   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  todos      Todo[]
  refreshTokens RefreshToken[]

  // Backs the admin user listing (ORDER BY created_at DESC, cursor on id).
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  // SHA-256 hex of the opaque refresh token. The raw token (256 bits of
  // entropy) is returned to the client once and never stored — only this
  // hash is persisted, so a DB leak can't be replayed as a valid token.
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at")
  // Set when the token is rotated (on /auth/refresh) or revoked (logout).
  // A non-null revokedAt means the token is dead; presenting it again is
  // treated as reuse/theft.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  // Hash of the token that superseded this one during rotation — lets an
  // operator walk the rotation chain when investigating a reuse event.
  replacedByHash String? @map("replaced_by_hash")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditEntry {
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  changedAt     DateTime  @default(now()) @map("changed_at") @db.Timestamptz
  entityType    String    @map("entity_type")
  entityId      String?   @map("entity_id") @db.Uuid
  action        String
  outcome       String
  outcomeReason String?   @map("outcome_reason")
  changedBy     String?   @map("changed_by") @db.Uuid
  sourceIp      String?   @map("source_ip") @db.Inet
  userAgent     String?   @map("user_agent")
  requestId     String?   @map("request_id")
  previousValue Json?     @map("previous_value")
  newValue      Json?     @map("new_value")
  metadata      Json?

  // Hypertable requires the time column in the primary key
  @@id([id, changedAt])
  @@map("audit_entries")
}
