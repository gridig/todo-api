generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id         String   @id @default(uuid()) @db.Uuid
  text       String   @db.VarChar(500)
  done       Boolean  @default(false)
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("todos")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  todos      Todo[]

  @@map("users")
}

model AuditEntry {
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  changedAt     DateTime  @default(now()) @map("changed_at") @db.Timestamptz
  entityType    String    @map("entity_type")
  entityId      String?   @map("entity_id") @db.Uuid
  action        String
  outcome       String
  outcomeReason String?   @map("outcome_reason")
  changedBy     String?   @map("changed_by") @db.Uuid
  sourceIp      String?   @map("source_ip") @db.Inet
  userAgent     String?   @map("user_agent")
  requestId     String?   @map("request_id")
  previousValue Json?     @map("previous_value")
  newValue      Json?     @map("new_value")
  metadata      Json?

  // Hypertable requires the time column in the primary key
  @@id([id, changedAt])
  @@map("audit_entries")
}
